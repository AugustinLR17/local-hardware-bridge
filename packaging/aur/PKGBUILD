# PKGBUILD for local-hardware-bridge-bin
# Pre-built JAR from GitHub Releases — no compilation needed
# AUR package name: local-hardware-bridge-bin
# Maintainer: Augustin Roux <augustin@augustin-roux.info>

pkgname='local-hardware-bridge-bin'
_pkgname='local-hardware-bridge'
pkgver='2.2.1'
pkgrel=1
pkgdesc='Exposes local printers and serial ports to web browsers via WebSocket and HTTP APIs'
arch=('any')
url='https://github.com/AugustinLR17/local-hardware-bridge'
license=('MIT')
depends=('java-runtime>=21')
provides=('local-hardware-bridge')
conflicts=('local-hardware-bridge')
source=("$_pkgname-$pkgver.jar::https://github.com/AugustinLR17/local-hardware-bridge/releases/download/v$pkgver/local-hardware-bridge-$pkgver.jar"
        "LICENSE::https://raw.githubusercontent.com/AugustinLR17/local-hardware-bridge/v$pkgver/LICENSE")
# SHA256 will be generated by CI and injected via a .sha256 sidecar
# For manual setup, run: sha256sum local-hardware-bridge-*.jar
sha256sums=('SKIP'
            'SKIP')
noextract=("$_pkgname-$pkgver.jar")

package() {
    # Install the JAR
    install -Dm644 "$srcdir/$_pkgname-$pkgver.jar" "$pkgdir/usr/share/$_pkgname/$_pkgname.jar"

    # Install license
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Desktop entry
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" <<EOF
[Desktop Entry]
Name=Local Hardware Bridge
Comment=Exposes local printers and serial ports to web browsers
Exec=/usr/bin/java -jar /usr/share/$_pkgname/$_pkgname.jar
Icon=$_pkgname
Terminal=false
Type=Application
Categories=Utility;Network;
EOF

    # Wrapper script (GUI mode by default, -Dlhb.server=true for headless)
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_pkgname" <<EOF
#!/bin/sh
exec java -jar /usr/share/$_pkgname/$_pkgname.jar "\$@"
EOF

    # Headless server wrapper
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_pkgname-server" <<EOF
#!/bin/sh
exec java -Dlhb.server=true -cp /usr/share/$_pkgname/$_pkgname.jar io.github.augustinlr17.localhardwarebridge.Server "\$@"
EOF
}